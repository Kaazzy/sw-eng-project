@model sw_project.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="hero bg-light py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-4 fw-bold">Welcome to FinanceApp</h1>
                <p class="lead text-muted">Track your expenses quickly and easily. Add expenses, view charts and manage categories.</p>
                <p>
                    <a asp-controller="Expenses" asp-action="Create" class="btn btn-primary btn-lg me-2">Add Expense</a>
                    <a asp-controller="Expenses" asp-action="Index" class="btn btn-outline-secondary btn-lg">View Expenses</a>
                </p>
            </div>
        </div>
    </div>
            
</div>

<div class="container my-4">
        <div class="row g-3">
        <div class="col-md-4">
            <div class="card stat-card p-3">
                <div class="stat-title">Total Expenses</div>
                <div class="stat-value">@Model.TotalExpenses.ToString("C")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card p-3">
                <div class="stat-title">This Month</div>
                <div class="stat-value">@Model.ThisMonthTotal.ToString("C")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card p-3">
                <div class="stat-title">Categories</div>
                <div class="stat-value">@Model.CategoriesCount</div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card p-3">
                <h5 class="mb-3">Recent Expenses</h5>
                <ul class="list-group list-group-flush">
                    @if (Model.RecentExpenses != null && Model.RecentExpenses.Any())
                    {
                        foreach (var e in Model.RecentExpenses)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@e.Description</div>
                                    <div class="text-muted" style="font-size:.85rem;">@e.Category — @e.Date.ToString("yyyy-MM-dd")</div>
                                </div>
                                <div class="text-nowrap">@e.Amount.ToString("C")</div>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item">No expenses yet</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
