@model sw_project.Models.Expense

@{
    ViewData["Title"] = "Edit Expense";
}

<h2>Edit Expense</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* Hidden ID *@
            <input asp-for="ID" type="hidden" />

            <!-- Description -->
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- Amount + Currency -->
            <div class="form-group">
                <label class="control-label">Amount</label>
                <div class="input-group">
                    <!-- Currency symbol -->
                    <span class="input-group-text" id="currencySymbol">EGP</span>

                    <!-- Amount input -->
                    <input asp-for="Amount" class="form-control" placeholder="Enter amount" />

                    <!-- Currency dropdown -->
                    <select asp-for="Currency" class="form-select" id="currencySelect"
                            asp-items="Html.GetEnumSelectList<sw_project.Models.Currency>()">
                        <option value="">Select</option>
                    </select>
                </div>
                <span asp-validation-for="Amount" class="text-danger"></span>
                <span asp-validation-for="Currency" class="text-danger"></span>
            </div>

            <!-- Category -->
            <div class="form-group">
                <label asp-for="Category" class="control-label"></label>
                <input asp-for="Category" class="form-control" />
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <!-- Date -->
            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" class="form-control" type="date" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <!-- Buttons -->
            <div class="form-group mt-2">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        const currencySelect = document.getElementById("currencySelect");
        const currencySymbol = document.getElementById("currencySymbol");

        function updateSymbol() {
            const value = currencySelect?.value;
            switch(value){
                case "EGP": currencySymbol.textContent = "EGP"; break;
                case "USD": currencySymbol.textContent = "$"; break;
                case "EUR": currencySymbol.textContent = "€"; break;
                case "GBP": currencySymbol.textContent = "£"; break;
                default: currencySymbol.textContent = ""; 
            }
        }

        if (currencySelect) {
            currencySelect.addEventListener("change", updateSymbol);
            updateSymbol(); // initialize on page load
        }
    </script>
}
